{
  "name": "@shiplightai/quality-ui",
  "version": "0.1.0",
  "description": "Shared React/Mantine presentation for Quality Explorer and Shiplight Quality Center.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.tsx",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/testing.tsx",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shiplightai/quality-core": "workspace:*",
    "@shiplightai/quality-map": "workspace:*"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.4.1",
    "lucide-react": ">=1.8.0",
    "next": ">=16.2.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
