{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shiplight.dev/schemas/quality/observation-sets.schema.json",
  "title": "Quality Observation Sets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_sets"
  ],
  "properties": {
    "observation_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/observationSet"
      }
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "profileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "observationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "profiles"
      ],
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/nonEmptyString"
            },
            {
              "not": {
                "pattern": "^[Ss][Tt][Aa][Tt][Ii][Cc]$"
              }
            }
          ]
        },
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/profileReference"
          }
        }
      }
    }
  }
}
