{
  "name": "shiplight-quality",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, evidence-backed quality maps for software.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "generate:quality-map-schema": "tsx packages/quality-map/src/generate.ts",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "adm-zip": "0.5.16",
    "ajv": "6.14.0",
    "jsdom": "^29.1.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "yaml": "2.9.0"
  }
}
